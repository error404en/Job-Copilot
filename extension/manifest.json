{
  "manifest_version": 3,
  "name": "JobCopilot Auto-Fill & AI Job Analyzer",
  "version": "1.2",
  "description": "1-Click ATS Auto-Fill and AI Job Fit Analysis for Greenhouse, Lever, Ashby, Workday, SmartRecruiters, Keka, and enterprise career portals.",
  "permissions": ["activeTab", "scripting", "tabs", "cookies"],
  "host_permissions": [
    "https://job-copilot-ci8e.onrender.com/*",
    "https://job-copilot-gold.vercel.app/*",
    "http://localhost:8000/*",
    "http://localhost:3000/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.workdayjobs.com/*",
    "*://*.keka.com/*",
    "*://*.yello.co/*",
    "*://*.mynexthire.com/*",
    "*://*.joinsuperset.com/*",
    "*://*.gem.com/*",
    "*://*.pwc.com/*",
    "*://*.hackerrank.com/*",
    "*://*.cisco.com/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.workdayjobs.com/*",
        "*://*.keka.com/*",
        "*://*.yello.co/*",
        "*://*.mynexthire.com/*",
        "*://*.joinsuperset.com/*",
        "*://*.gem.com/*",
        "*://*.pwc.com/*",
        "*://*.hackerrank.com/*",
        "*://*.cisco.com/*"
      ],
      "js": ["content-scripts/auto_apply.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.naukri.com/*"
      ],
      "js": ["content-scripts/capture.js"],
      "run_at": "document_idle"
    }
  ]
}
