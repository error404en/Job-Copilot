{
  "manifest_version": 3,
  "name": "JobCopilot Link Finder & Analyzer",
  "version": "1.0",
  "description": "Send any job posting directly to JobCopilot for instant AI analysis.",
  "permissions": ["activeTab", "scripting", "tabs", "cookies"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:3000/*",
    "*://*.greenhouse.io/*",
    "*://jobs.lever.co/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["content-scripts/auto_apply.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.naukri.com/*"
      ],
      "js": ["content-scripts/capture.js"],
      "run_at": "document_idle"
    }
  ]
}
