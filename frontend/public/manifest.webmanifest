{
  "name": "Job Copilot",
  "short_name": "Job Copilot",
  "description": "Smart career pipeline and opportunity tracker.",
  "start_url": "/inbox",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
